(test-equal "map" '(2 3 4) (map (lambda (x) (+ x 1)) '(1 2 3)))
(test-equal "map with a built-in procedure" '(1 4 9) (map square '(1 2 3)))
(test-equal "map over two lists" '(11 22) (map + '(1 2) '(10 20)))
(define seen '())
(for-each (lambda (x) (set! seen (cons x seen))) '(a b c))
(test-equal "for-each, in order" '(c b a) seen)
