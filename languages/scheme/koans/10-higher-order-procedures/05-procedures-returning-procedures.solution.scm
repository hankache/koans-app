(define (adder n) (lambda (x) (+ x n)))
(define (compose f g) (lambda (x) (f (g x))))
(define (twice f) (compose f f))
(test-equal "an adder" 8 ((adder 5) 3))
(test-equal "map with a made procedure" '(11 12) (map (adder 10) '(1 2)))
(test-equal "compose runs g, then f" 11 ((compose (adder 1) (lambda (x) (* 2 x))) 5))
(test-equal "twice" 16 ((twice square) 2))
