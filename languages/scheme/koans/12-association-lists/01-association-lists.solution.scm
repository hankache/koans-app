(define ages '((ada . 36) (alan . 41)))
(test-equal "assq finds the pair" '(ada . 36) (assq 'ada ages))
(test-equal "cdr gives its value" 41 (cdr (assq 'alan ages)))
(test-equal "#f for a missing key" #f (assq 'grace ages))
(test-equal "assoc compares with equal?, so strings work" '("b" . 2) (assoc "b" '(("a" . 1) ("b" . 2))))
