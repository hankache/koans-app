(define (quicksort lst)
  (if (null? lst)
      '()
      (let ((pivot (car lst)) (rest (cdr lst)))
        (append (quicksort (filter (lambda (x) (< x pivot)) rest))
                (list pivot)
                (quicksort (filter (lambda (x) (>= x pivot)) rest))))))
(test-equal "sorted" '(1 2 3 5 8) (quicksort '(5 3 8 1 2)))
(test-equal "duplicates stay" '(1 1 2) (quicksort '(1 2 1)))
(test-equal "nothing to sort" '() (quicksort '()))
