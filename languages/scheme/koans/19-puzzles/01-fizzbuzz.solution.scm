(define (fizzbuzz n)
  (cond ((= 0 (remainder n 15)) "FizzBuzz")
        ((= 0 (remainder n 3)) "Fizz")
        ((= 0 (remainder n 5)) "Buzz")
        (else (number->string n))))
(test-equal "a multiple of 3" "Fizz" (fizzbuzz 9))
(test-equal "a multiple of 5" "Buzz" (fizzbuzz 10))
(test-equal "a multiple of both" "FizzBuzz" (fizzbuzz 30))
(test-equal "the first five" '("1" "2" "Fizz" "4" "Buzz") (map fizzbuzz (iota 5 1)))
