(define (sum lst) (if (null? lst) 0 (+ (car lst) (sum (cdr lst)))))
(define (doubled lst) (if (null? lst) '() (cons (* 2 (car lst)) (doubled (cdr lst)))))
(define (evens lst)
  (cond ((null? lst) '())
        ((even? (car lst)) (cons (car lst) (evens (cdr lst))))
        (else (evens (cdr lst)))))
(test-equal "sum" 10 (sum '(1 2 3 4)))
(test-equal "a new list, built with cons" '(2 4 6) (doubled '(1 2 3)))
(test-equal "keeping some items" '(2 4) (evens '(1 2 3 4 5)))
