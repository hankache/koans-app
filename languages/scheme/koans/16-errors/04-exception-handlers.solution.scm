(test-equal "the handler's value replaces the raise" 43 (with-exception-handler (lambda (e) 42) (lambda () (+ 1 (raise-continuable 'need-a-number)))))
(test-equal "the handler sees what was raised" 'need-a-number (with-exception-handler (lambda (e) e) (lambda () (raise-continuable 'need-a-number))))
(define cleaned #f)
(guard (e (#t #f)) (dynamic-wind (lambda () #f) (lambda () (error "fail")) (lambda () (set! cleaned #t))))
(test-equal "dynamic-wind cleans up after an error" #t cleaned)
