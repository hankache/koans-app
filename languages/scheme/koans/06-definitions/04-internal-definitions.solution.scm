(define (hypotenuse-squared a b)
  (define (sq n) (* n n))
  (+ (sq a) (sq b)))
(test-equal "a helper defined inside" 25 (hypotenuse-squared 3 4))
(define counter 0)
(set! counter (+ counter 1))
(set! counter (+ counter 1))
(test-equal "set! changes a value" 2 counter)
(test-error "sq is local: it doesn't exist out here" #t (sq 2))
