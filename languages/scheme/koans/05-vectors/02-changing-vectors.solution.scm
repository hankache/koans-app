(define v (make-vector 3 0))
(test-equal "make-vector fills it" #(0 0 0) v)
(vector-set! v 0 'start)
(test-equal "vector-set! changes one item" #(start 0 0) v)
(vector-fill! v 7)
(test-equal "vector-fill! changes them all" #(7 7 7) v)
(define copy (vector-copy v))
(vector-set! copy 0 1)
(test-equal "a copy changes alone" 7 (vector-ref v 0))
