(define port (open-input-string "hello world\nsecond line"))
(test-equal "read-char" #\h (read-char port))
(test-equal "read-line reads the rest of the line" "ello world" (read-line port))
(test-equal "then the next line" "second line" (read-line port))
(test-equal "the end of the text" #t (eof-object? (read-char port)))
(test-equal "read gives Scheme data" '(1 (2 three)) (read (open-input-string "(1 (2 three)) more")))
