(test-equal "memq gives the rest of the list from the item" '(c d) (memq 'c '(a b c d)))
(test-equal "or #f when it isn't there" #f (memq 'z '(a b c)))
(test-equal "member compares with equal?, so it finds lists" '((2) 3) (member '(2) '(1 (2) 3)))
(test-equal "memq doesn't: a new list is never eq?" #f (memq (list 2) '(1 (2) 3)))
(test-equal "the result works as a yes or no" 'found (if (memv 3 '(1 2 3)) 'found 'missing))
